{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicolasacchi/kb/schemas/kbc-cmd/1",
  "title": "kbc-cmd/1 command registry",
  "description": "kb-code's ONE declaration home for its keyboard and command surface (crates/kb-code-server/commands/registry.json). `kb-code commands doctor` is the semantic gate (conflicts, reserved chords); this schema checks structure only.",
  "type": "object",
  "required": [
    "schema",
    "leader",
    "presets",
    "reserved_chords",
    "context_keys",
    "scopes",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "kbc-cmd/1"
    },
    "leader": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "conflict_policy": {
      "type": "string"
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reserved_chords": {
      "type": "object",
      "required": [
        "hard",
        "passthrough"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "hard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "context_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "values"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "depth",
          "coactive_with"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "covers": {
            "type": "string"
          },
          "coactive_with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "group",
          "keys",
          "scope",
          "cli",
          "mutation",
          "side_effect",
          "lifecycle",
          "dispatch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "aka": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string"
          },
          "keys": {
            "type": "object",
            "required": [
              "vim",
              "plain",
              "helix"
            ],
            "properties": {
              "vim": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plain": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "helix": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "scope": {
            "type": "string"
          },
          "cli": {
            "type": "string"
          },
          "mutation": {
            "type": "string"
          },
          "side_effect": {
            "type": "string"
          },
          "lifecycle": {
            "enum": [
              "shipped",
              "planned",
              "retired"
            ]
          },
          "dispatch": {
            "enum": [
              "central",
              "surface"
            ]
          },
          "note": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "when": {
            "type": "string"
          },
          "vim_kind": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "ratified_conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affordance_anchor": {
            "type": "string"
          },
          "dismiss_order": {
            "type": "integer"
          },
          "browser_reserved": {
            "type": "string"
          },
          "retired_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
