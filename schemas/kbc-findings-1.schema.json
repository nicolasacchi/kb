{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicolasacchi/kb/schemas/kbc-findings/1",
  "title": "kbc-findings/1 findings import batch",
  "description": "The batch-import payload of POST /api/reviews/{id}/findings/import and `kb-code review findings import` (crates/kb-code-server/src/review_findings.rs, FindingsImportBody). Structural lint; the daemon's validation is the authority.",
  "type": "object",
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "kbc-findings/1"
    },
    "mode": {
      "enum": [
        "full",
        "additive"
      ]
    },
    "ps_number": {
      "type": "integer"
    },
    "import_note": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "severity",
          "category",
          "location",
          "title",
          "rationale"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^f-[a-z0-9-]+$"
          },
          "severity": {
            "enum": [
              "blocker",
              "concern",
              "ok"
            ]
          },
          "category": {
            "type": "string"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "lang": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "single",
            "range",
            "multi",
            "whole_file"
          ]
        },
        "lines": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "removed": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "single",
              "range",
              "multi"
            ]
          }
        }
      },
      "then": {
        "required": [
          "lines"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
