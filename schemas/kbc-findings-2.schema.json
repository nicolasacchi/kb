{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicolasacchi/kb/schemas/kbc-findings/2",
  "title": "kbc-findings/2 findings sidecar",
  "description": "The findings v2 sidecar accepted by `kb-code review compose --findings` and emitted as ~review/findings.json and by `kb-code review import-legacy` (crates/kb-code-server/src/review_doc/mod.rs, DocFinding). review_id/ps_number/superseded are present only on the pseudo-file render. category is free text at the storage layer; the closed vocabulary is checked by `review lint`, so it is not enumerated here. Structural lint; the daemon is the authority.",
  "type": "object",
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "kbc-findings/2"
    },
    "review_id": {
      "type": "integer"
    },
    "ps_number": {
      "type": "integer"
    },
    "superseded": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "category",
          "title",
          "rationale",
          "location"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^f-[a-z0-9-]+$"
          },
          "act": {
            "enum": [
              "issue",
              "question",
              "suggestion",
              "nitpick",
              "praise",
              "note",
              "todo",
              "chore"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "concern",
              "ok"
            ]
          },
          "category": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^f-[a-z0-9-]+$"
            }
          },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "lang": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "single",
            "range",
            "multi",
            "whole_file"
          ]
        },
        "lines": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "removed": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "single",
              "range",
              "multi"
            ]
          }
        }
      },
      "then": {
        "required": [
          "lines"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
