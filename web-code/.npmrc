# v0.44 F1 (C1 carry-over): enforce package.json `engines` at install time so a runner or
# image whose node is below the declared floor fails `npm ci` loudly instead of
# building on an untested runtime. (Dockerfile node:22 digest = 22.23.2 and the
# hosted runner = 22.23.x both satisfy the floor.)
engine-strict=true
