{
  "name": "kb-code-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "kb-code SPA \u2014 the read-first reader (repo picker + file tree + CM6 read-only viewer + outline rail + diff view) (W4.1/W4.2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "gen:themes": "node scripts/gen-themes.mjs",
    "gen:commands": "node scripts/gen-commands.mjs",
    "lint:themes": "node scripts/theme-lint.mjs",
    "lint:css-vars": "node scripts/css-undefined-vars.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.4",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
