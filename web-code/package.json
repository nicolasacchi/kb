{
  "name": "kb-code-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "kb-code SPA \u2014 the read-first reader (repo picker + file tree + CM6 read-only viewer + outline rail + diff view) (W4.1/W4.2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "gen:themes": "node scripts/gen-themes.mjs",
    "gen:commands": "node scripts/gen-commands.mjs",
    "lint:themes": "node scripts/theme-lint.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.8"
  }
}
